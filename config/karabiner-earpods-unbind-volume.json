{
  "title": "EarPods volume unbind",
  "rules": [
    {
      "description": "Disable EarPods inline volume buttons only",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "f12",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "vk_none"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 1452,
                  "product_id": 4363
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "f11",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "vk_none"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 1452,
                  "product_id": 4363
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "volume_increment"
          },
          "to": [
            {
              "key_code": "vk_none"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 1452,
                  "product_id": 4363
                },
                {
                  "vendor_id": 1452,
                  "product_id": 4363,
                  "is_consumer": true
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "volume_decrement"
          },
          "to": [
            {
              "key_code": "vk_none"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 1452,
                  "product_id": 4363
                },
                {
                  "vendor_id": 1452,
                  "product_id": 4363,
                  "is_consumer": true
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
